NODE_ENV=development
HOST=0.0.0.0
PORT=3001
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=

API_KEYS=generate-48-random-characters-one-per-client
ONLINE_WINDOW_SECONDS=120

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=telematics_service
DB_SSL=false

MQTT_ENABLED=true
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=telematics-service-change-me
MQTT_TOPIC_FILTER=telematics/+/telemetry
MQTT_GPS_TOPIC=fleet/+/gps
MQTT_OBD_TOPIC=fleet/+/obd

TRIP_WEBHOOK_URL=http://localhost:3000/api/v1/integrations/telematics/events
TRIP_WEBHOOK_SECRET=generate-48-random-characters-shared-with-the-school-api

SAFETY_SPEED_LIMIT_KMH=50
SAFETY_OVERSPEED_SECONDS=10
SAFETY_HARSH_BRAKE_KMH_PER_S=12
SAFETY_IDLE_MINUTES=5
SAFETY_ROUTE_DEVIATION_M=300
SAFETY_ROUTE_DEVIATION_SECONDS=30
SAFETY_COOLDOWN_SECONDS=300

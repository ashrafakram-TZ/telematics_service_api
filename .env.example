NODE_ENV=development
HOST=0.0.0.0
PORT=3001
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=

API_KEYS=generate-48-random-characters-one-per-client
ONLINE_WINDOW_SECONDS=120

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=telematics_service
DB_SSL=false

MQTT_ENABLED=true
